# Dependencies and build output (not used by this project, but
# kept here so they can never be committed by accident)
# ---------------------------------------------------------------
node_modules/
dist/
build/
__pycache__/
venv/
.venv/

# ---------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------
*.log
*.tmp
